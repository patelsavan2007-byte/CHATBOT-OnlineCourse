# ============================================================
# CHARUSAT Online Course Chatbot — Backend Environment Variables
# ============================================================
# Copy this file to backend/.env and fill in your values.
#
#   cp .env.example backend/.env
#
# ============================================================

# Google Gemini API key (primary LLM tier)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq API key (fallback LLM tier — uses Llama 3.3 70B)
# Get yours at: https://console.groq.com/keys
groq_API_KEY=your_groq_api_key_here
