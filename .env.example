# ============================================================
# CHARUSAT Online Course Chatbot — Environment Variables
# ============================================================
# Copy this file to backend/.env and fill in your values.
#
#   cp .env.example backend/.env
#
# ============================================================

# Google Gemini API key (primary LLM tier)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq API key (fallback LLM tier — uses Llama 3.3 70B)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ============================================================
# MongoDB Atlas
# ============================================================
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net

# ============================================================
# Authentication
# ============================================================
JWT_SECRET=change-this-to-a-random-secret-in-production

# Admin account email (receives admin role automatically)
ADMIN_EMAIL=admin@example.com

# Development auto-login (set to true for local dev only)
# NEVER enable in production
DEV_AUTO_LOGIN=false

# Guest message limit before requiring authentication
GUEST_MESSAGE_LIMIT=4

# ============================================================
# Google OAuth (optional)
# ============================================================
# Get credentials at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================================
# NOTE for Render deployment:
# Set these SAME variables in the Render dashboard under
# Environment → Environment Variables. Do NOT commit real keys.
# ============================================================
