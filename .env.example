# ============================================================
# CHARUSAT Online Course Chatbot — Environment Variables
# ============================================================
# Copy this file to backend/.env for local backend testing,
# or set these in the Render Dashboard (Environment tab).
#
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ============================================================

# --- LLM Providers ---
# Google Gemini API key (Primary LLM)
# Get key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq API key (Failover LLM — Llama 3.3 70B)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Dedicated suggestion keys (prevents suggestion traffic consuming main quota)
# GROQ_API_KEY_SUGGEST=your_groq_suggest_key_here
# GOOGLE_API_KEY_SUGGEST=your_google_suggest_key_here

# --- Database (MongoDB Atlas) ---
# Connection string from MongoDB Atlas:
# IMPORTANT: In MongoDB Atlas -> Network Access, add 0.0.0.0/0 (Allow from anywhere)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# --- Security & Authentication ---
# Generate a secure 32+ character random string (REQUIRED on Render/Production)
JWT_SECRET=generate-a-strong-random-secret-key-32-chars-minimum

# Admin email (user signing up with this email gets admin role)
ADMIN_EMAIL=admin@charusat.ac.in

# Initial admin password (used when seeding admin credentials)
ADMIN_PASSWORD=change-this-admin-password

# Development auto-login (MUST be false in production/Render)
DEV_AUTO_LOGIN=false

# Number of free guest messages before requiring sign-up/login
GUEST_MESSAGE_LIMIT=4

# --- CORS & Domains ---
# Production frontend domain (optional, since *.vercel.app is allowed by default)
# ALLOWED_ORIGINS=https://your-custom-domain.com,https://your-app.vercel.app

# --- Google OAuth (Optional) ---
# Credentials from https://console.cloud.google.com/apis/credentials
# Make sure to add your Vercel URL to "Authorized JavaScript origins"
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Knowledge Base Manager & GitHub Integration (Optional) ---
# Set these if using the Admin panel to sync KB with GitHub repository
# GITHUB_REPO=your-github-username/your-repo-name
# GITHUB_BRANCH=main
# GITHUB_TOKEN=github_pat_your_token_here
# GITHUB_WORKFLOW_FILE=sync-knowledge-base.yml
