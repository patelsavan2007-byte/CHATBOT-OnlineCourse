# Frontend environment variables (Vite)
# Only VITE_ prefixed variables are exposed to the browser

# Backend API URL:
# - Local development: http://localhost:8000
# - Vercel production: https://<your-render-service-name>.onrender.com (NO trailing slash)
VITE_API_URL=http://localhost:8000

# Google OAuth Client ID (Optional - from Google Cloud Console)
# If provided, enables Google One-Tap and Google Sign-in button
VITE_GOOGLE_CLIENT_ID=

# Guest message count limit before requiring login (Default: 4)
VITE_GUEST_MESSAGE_LIMIT=4
