# ============================================================
# CHARUSAT Chatbot — Frontend Environment Variables
# ============================================================
# For Vercel deployment:
#   Set VITE_API_URL in Vercel dashboard → Settings → Environment Variables
#
# For local development:
#   Copy this file to .env and fill in the backend URL
#   cp .env.example .env
# ============================================================

# Backend API URL — points to your Render deployment
# Replace with your actual Render URL after deploying the backend
VITE_API_URL=https://charusat-chatbot-api.onrender.com
